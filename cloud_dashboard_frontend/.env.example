# Frontend environment - copy to .env and adjust as needed

# Base URL for backend REST API (no trailing slash)
REACT_APP_API_BASE_URL=http://localhost:4000

# Socket.IO server URL and path (path must match backend SOCKET_PATH)
REACT_APP_SOCKET_URL=http://localhost:4000
REACT_APP_SOCKET_PATH=/socket.io

# Note: The following variables are backend-only and NOT used by the frontend build:
# MONGODB_URI, JWT_SECRET, DEFAULT_ADMIN_NAME, DEFAULT_ADMIN_EMAIL, DEFAULT_ADMIN_PASSWORD
# Keep them in the backend .env file only.
