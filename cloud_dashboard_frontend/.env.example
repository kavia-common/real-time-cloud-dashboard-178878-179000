# Frontend Environment Variables (.env)
# Copy this file to .env and adjust values for your environment.

# Base URL for REST API (no trailing slash)
REACT_APP_API_BASE_URL=http://localhost:4000

# Base URL for Socket.IO server (no trailing slash)
REACT_APP_SOCKET_URL=http://localhost:4000

# Socket.IO path - must match backend SOCKET_PATH
# Default Socket.IO path is /socket.io. Only change if you have customized it in backend.
REACT_APP_SOCKET_PATH=/socket.io

# Note: The variables below are not used by the frontend directly, but may be included
# for containerized environments where a single env source is shared.
# They will be ignored by the React app at runtime but kept here for completeness.
REACT_APP_MONGO_URI=
REACT_APP_MONGO_DB_NAME=
REACT_APP_MONGODB_URI=
REACT_APP_JWT_SECRET=
REACT_APP_DEFAULT_ADMIN_NAME=
REACT_APP_DEFAULT_ADMIN_EMAIL=
REACT_APP_DEFAULT_ADMIN_PASSWORD=
