# Frontend environment variables for Real-time Cloud Dashboard
# Ensure these are set by deployment. Do NOT commit actual secrets.

# Base URL of backend API (include API prefix if backend mounts at /api)
# Example: http://localhost:4000/api
REACT_APP_API_BASE_URL=http://localhost:4000/api

# Socket.IO absolute base URL (protocol + host + optional port), no path or namespace
# Must match backend origin where Socket.IO server is hosted.
# Example: http://localhost:4000
REACT_APP_SOCKET_URL=http://localhost:4000

# Socket path must match backend env.SOCKET_PATH (default '/socket.io')
# Example: /socket.io
REACT_APP_SOCKET_PATH=/socket.io

# Optional Mongo read-only values for UI demos; not used by frontend code directly
REACT_APP_MONGO_URI=
REACT_APP_MONGO_DB_NAME=
