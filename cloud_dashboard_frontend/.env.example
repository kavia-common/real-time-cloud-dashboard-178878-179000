# Frontend Environment Variables
# Copy this file to ".env" and update values per environment.

# Base URL for the backend API (e.g., https://api.example.com or http://localhost:4000)
REACT_APP_API_BASE_URL=http://localhost:4000

# WebSocket server URL (e.g., wss://api.example.com or http://localhost:4000)
REACT_APP_SOCKET_URL=http://localhost:4000

# Socket.IO custom path, if configured on backend (must match server config)
# Example if backend uses: io.attach(server, { path: '/socket.io' })
REACT_APP_SOCKET_PATH=/socket.io
