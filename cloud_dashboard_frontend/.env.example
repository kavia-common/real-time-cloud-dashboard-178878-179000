# Example frontend environment configuration for React app
# Copy this file to ".env" and adjust values per environment.
# Note: After changing any REACT_APP_* variables, you must restart the dev server or rebuild for changes to take effect.

# Backend API base URL (must include /api)
REACT_APP_API_BASE_URL=http://localhost:4000/api

# WebSocket base URL (without path)
REACT_APP_SOCKET_URL=http://localhost:4000

# Socket.IO path on the backend
REACT_APP_SOCKET_PATH=/socket.io

# The variables below are referenced by the application or deployment.
# If you do not use them locally, you can leave them unset. For production, set securely.
# REACT_APP_MONGO_URI=
# REACT_APP_MONGO_DB_NAME=
# REACT_APP_MONGODB_URI=
# REACT_APP_JWT_SECRET=
# REACT_APP_DEFAULT_ADMIN_NAME=
# REACT_APP_DEFAULT_ADMIN_EMAIL=
# REACT_APP_DEFAULT_ADMIN_PASSWORD=
