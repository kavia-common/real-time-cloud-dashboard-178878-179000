# Frontend environment configuration for Real-Time Cloud Dashboard (React)
# Copy this file to `.env` at the project root and fill in values as needed.

# Base URL for HTTP API to Express backend
# Example: http://localhost:4000
REACT_APP_API_BASE_URL=http://localhost:4000

# Base URL for Socket.IO server (matches backend server host)
# Example: http://localhost:4000
REACT_APP_SOCKET_URL=http://localhost:4000

# Socket.IO server path (ensure it matches backend server path)
# Default Socket.IO path is /socket.io
REACT_APP_SOCKET_PATH=/socket.io
