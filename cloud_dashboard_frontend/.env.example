# Frontend Environment Variables (React)

# Base URL for REST API (include scheme and port). Example for local dev:
# http://localhost:4000/api or http://localhost:4000
# If your backend prefixes routes with /api, include it here (e.g., http://localhost:4000/api)
REACT_APP_API_BASE_URL=http://localhost:4000

# Base URL for Socket.IO (include scheme and port). Example:
# http://localhost:4000
REACT_APP_SOCKET_URL=http://localhost:4000

# Optional Socket.IO path (must match backend SOCKET_PATH). Default is /socket.io
REACT_APP_SOCKET_PATH=/socket.io

# Note:
# - Copy this file to .env and adjust values for your environment:
#     cp .env.example .env
# - The app reads these at build time; restart dev server after changes.
