# Server
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Database (MongoDB Atlas connection string recommended)
# Example: mongodb+srv://<user>:<pass>@cluster0.xxxxxx.mongodb.net/cloud_dashboard?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/cloud_dashboard

# Auth
JWT_SECRET=please-change-me

# Socket.IO
SOCKET_PATH=/socket.io

# Metrics
METRIC_TICK_MS=3000

# Default admin bootstrap (created on first run if missing)
DEFAULT_ADMIN_NAME=Administrator
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=admin123
