# Backend Environment Variables (.env)
# Copy this file to .env and fill with your values.

# Server
PORT=4000

# MongoDB (Atlas SRV recommended)
# Example:
# MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-host>/<db-name>?retryWrites=true&w=majority&appName=CloudDashboard"
MONGODB_URI=

# JWT secret for signing tokens (use a strong, unique string)
JWT_SECRET=please-change-me-in-production

# CORS - Frontend origin allowed to call this backend
CORS_ORIGIN=http://localhost:3000

# Socket.IO configuration
# Path must match frontend REACT_APP_SOCKET_PATH
SOCKET_PATH=/socket.io

# Metrics emission interval (ms) for realtime updates
METRIC_TICK_MS=3000

# Default admin bootstrap (optional but recommended for first login)
# If DEFAULT_ADMIN_EMAIL and DEFAULT_ADMIN_PASSWORD are provided and user does not exist,
# the app will create an admin account on startup.
DEFAULT_ADMIN_NAME=Administrator
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=ChangeThisAdminPassword123!
