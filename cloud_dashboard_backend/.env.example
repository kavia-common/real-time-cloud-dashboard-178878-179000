# Backend environment - copy to .env and fill the required values

# Required
PORT=4000
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-host>/<db-name>?retryWrites=true&w=majority&appName=CloudDashboard"
JWT_SECRET="<generate-a-strong-secret>"
CORS_ORIGIN=http://localhost:3000

# WebSocket
SOCKET_PATH=/socket.io
METRIC_TICK_MS=3000

# Optional admin bootstrap (if provided and user doesn't exist, it will be created as admin)
DEFAULT_ADMIN_NAME="Administrator"
DEFAULT_ADMIN_EMAIL="admin@example.com"
DEFAULT_ADMIN_PASSWORD="ChangeMe123!"
