# Backend Environment Configuration - Cloud Dashboard Backend
# Copy this file to .env and fill in the values

# Server Configuration
PORT=4000

# Database Configuration
# MongoDB Atlas connection string (SRV format recommended)
# Format: mongodb+srv://<username>:<password>@<cluster-host>/<db-name>?retryWrites=true&w=majority
# Example: mongodb+srv://dbuser:dbpass@cluster0.abc123.mongodb.net/cloud_dashboard?retryWrites=true&w=majority
# For local MongoDB: mongodb://localhost:27017/cloud_dashboard
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/cloud_dashboard

# Security
# JWT secret for signing authentication tokens
# MUST be a strong, unique secret in production (32+ characters recommended)
JWT_SECRET=your-super-secret-jwt-key-change-me-in-production

# CORS Configuration
# Allowed origin for Cross-Origin Resource Sharing
# Must match the frontend URL to avoid CORS issues
# Development: http://localhost:3000
# Production: https://yourdomain.com
CORS_ORIGIN=http://localhost:3000

# Socket.IO Configuration
# Path for Socket.IO server endpoint
# Must match frontend REACT_APP_SOCKET_PATH
# Default: /socket.io (change only if needed)
SOCKET_PATH=/socket.io

# Metrics Configuration
# Interval in milliseconds for emitting metric:update events
# Default: 3000 (3 seconds)
# Minimum: 250 (enforced by validation)
METRIC_TICK_MS=3000

# Default Admin Bootstrap
# Used on first boot to create an initial admin account
# IMPORTANT: Change these values immediately after first login in production
DEFAULT_ADMIN_NAME=Administrator
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=changeme123

# Notes:
# - Never commit the .env file to version control
# - Use strong passwords and secrets in production
# - Ensure MongoDB Atlas Network Access allows your IP
# - URL-encode special characters in MONGODB_URI password
# - Keep CORS_ORIGIN synchronized with frontend deployment URL
