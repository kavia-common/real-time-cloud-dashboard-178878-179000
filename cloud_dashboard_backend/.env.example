# Backend environment variables

# Server
PORT=4000

# MongoDB
# Use Atlas SRV connection or local
# Example Atlas:
# MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-host>/<db-name>?retryWrites=true&w=majority&appName=CloudDashboard"
MONGODB_URI="mongodb://localhost:27017/cloud_dashboard"

# JWT
JWT_SECRET="replace-with-a-strong-secret"

# CORS
# Must match your frontend origin exactly
CORS_ORIGIN="http://localhost:3000"

# Socket.IO path (must match frontend REACT_APP_SOCKET_PATH)
SOCKET_PATH="/socket.io"

# Metric ticker cadence in milliseconds
METRIC_TICK_MS=3000

# Default admin bootstrap (idempotent)
DEFAULT_ADMIN_NAME="Administrator"
DEFAULT_ADMIN_EMAIL="admin@example.com"
DEFAULT_ADMIN_PASSWORD="admin123"
