# Backend environment example for Cloud Dashboard
# Copy to .env and fill in your values.

# HTTP server port
PORT=4000

# MongoDB connection string
# For MongoDB Atlas (recommended), use the SRV URI format copied from Atlas:
# Example (replace placeholders and URL-encode special characters in password):
# mongodb+srv://<username>:<password>@<cluster-host>/<db-name>?retryWrites=true&w=majority&appName=CloudDashboard
MONGODB_URI=mongodb+srv://cyberhash4_db_user:N2MGF0xoSia6pVB2@cluster0.vumo0ae.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0

# JWT secret for signing tokens (use a strong unique value in production)
JWT_SECRET=admin

# CORS origin allowed for the frontend (for local development):
CORS_ORIGIN=http://localhost:3000

# Socket.IO path (default: /socket.io)
SOCKET_PATH=/socket.io

# Interval (ms) for emitting metric updates
METRIC_TICK_MS=3000

# Default admin bootstrapped on startup (used once if not present)
DEFAULT_ADMIN_NAME=Administrator
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=admin123
