# Cloud Dashboard Backend - .env.example
# Copy to .env and fill in values. Never commit real credentials.

# Server
PORT=4000

# MongoDB
# Example Atlas SRV URI:
# mongodb+srv://<username>:<password>@<cluster-host>/<db-name>?retryWrites=true&w=majority&appName=CloudDashboard
MONGODB_URI=mongodb://localhost:27017/cloud_dashboard

# Auth
JWT_SECRET=change-me-in-production

# CORS
# For local dev with CRA:
# http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Socket.IO
SOCKET_PATH=/socket.io

# Metrics ticker (ms)
METRIC_TICK_MS=3000

# Default admin bootstrap (created on startup if not present)
DEFAULT_ADMIN_NAME=Administrator
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=admin123
