# Example Backend Environment Configuration - Copy to .env and customize

# Server
PORT=4000

# Database
# MongoDB URI (Atlas recommended). Include db name and params as needed.
# Example:
# MONGODB_URI="mongodb+srv://<user>:<pass>@<cluster-host>/<db>?retryWrites=true&w=majority&appName=CloudDashboard"
MONGODB_URI=""

# Security
# Generate a strong, unique secret (32+ chars). Do NOT commit real secrets.
JWT_SECRET="ChangeMeToASecret!"

# CORS
# Must match your frontend origin (development default below).
CORS_ORIGIN=http://localhost:3000

# Socket.IO
# Path must stay in sync with frontend REACT_APP_SOCKET_PATH.
SOCKET_PATH=/socket.io

# Metrics
# Interval in milliseconds for emitting metric:update on /metrics namespace
METRIC_TICK_MS=3000

# Default Admin Bootstrap
# Used on first boot to seed an admin account if none exists.
DEFAULT_ADMIN_NAME=Administrator
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD="ChangeMe123!"
