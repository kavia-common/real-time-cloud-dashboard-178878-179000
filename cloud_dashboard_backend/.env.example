# Server
PORT=4000

# MongoDB (Atlas recommended)
# Example:
# mongodb+srv://<username>:<password>@<cluster-host>/<db-name>?retryWrites=true&w=majority&appName=CloudDashboard
MONGODB_URI=mongodb://localhost:27017/cloud_dashboard

# Auth
JWT_SECRET=change-me-in-production

# CORS and Sockets
# Must match your frontend origin and socket path
CORS_ORIGIN=http://localhost:3000
SOCKET_PATH=/socket.io

# Realtime metrics emission interval (ms)
METRIC_TICK_MS=3000

# Default admin bootstrap
DEFAULT_ADMIN_NAME=Administrator
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=admin123
