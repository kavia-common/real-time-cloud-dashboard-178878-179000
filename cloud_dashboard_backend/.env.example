# Backend environment variables

# Server
PORT=4000

# MongoDB Atlas connection string (use SRV; replace placeholders)
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-host>/<db-name>?retryWrites=true&w=majority&appName=CloudDashboard"

# Auth
JWT_SECRET="replace-with-a-strong-secret"

# CORS
CORS_ORIGIN="http://localhost:3000"

# Socket.IO
SOCKET_PATH="/socket.io"

# Metrics
METRIC_TICK_MS=3000

# Default Admin Bootstrap (idempotent)
DEFAULT_ADMIN_NAME="Administrator"
DEFAULT_ADMIN_EMAIL="admin@example.com"
DEFAULT_ADMIN_PASSWORD="admin123"
