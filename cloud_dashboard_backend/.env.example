# Cloud Dashboard Backend - Environment Example
# Copy this file to `.env` and adjust values for your environment.

# HTTP server port
PORT=4000

# MongoDB connection (use your MongoDB Atlas connection string)
# Example Atlas string:
# mongodb+srv://<username>:<password>@<cluster-url>/<db-name>?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/cloud_dashboard

# JWT secret used to sign access tokens (set a strong, unique value in production)
JWT_SECRET=change-me-in-production

# CORS allowed origin for the frontend. In development, set to the React dev server URL.
# e.g., http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Socket.IO server path. The frontend must use this same path in REACT_APP_SOCKET_PATH if changed.
SOCKET_PATH=/socket.io

# Interval (ms) for emitting demo metric updates via Socket.IO
METRIC_TICK_MS=3000

# Default admin bootstrap (created/ensured on startup)
DEFAULT_ADMIN_NAME=Administrator
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=admin123
