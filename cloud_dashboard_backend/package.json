{
  "name": "cloud_dashboard_backend",
  "version": "0.1.0",
  "private": true,
  "description": "Express + Socket.IO + Mongoose backend for Real-time Cloud Dashboard",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development node --watch src/server.js",
    "start": "node src/server.js",
    "lint": "echo \"No linter configured\"",
    "health": "node -e \"import('./src/config/env.js').then(({env})=>console.log('OK on port', env.PORT))\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.1",
    "morgan": "^1.10.0",
    "socket.io": "^4.7.5"
  },
  "engines": {
    "node": ">=18"
  }
}
